PROJECT_NAME="Enchères & Drafts IA API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_long_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
BACKEND_CORS_ORIGINS=["*"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=encheres_db
DATABASE_URL=""

# Redis Cache & Real-time
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Google Gemini API
GEMINI_API_KEY="replace_with_your_actual_gemini_api_key"
GEMINI_MODEL="gemini-1.5-flash"

# Game Economy & Draft Rules
INITIAL_FREE_TOKENS=3
AI_DECK_CREATION_TOKEN_COST=1
DEFAULT_STARTING_BUDGET=1000
DEFAULT_BID_TIMER_SECONDS=15
MAX_ROUNDS_PER_GAME=10
