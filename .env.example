PROJECT_NAME="Enchères & Drafts IA API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=False
SQL_ECHO=False
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_32_bytes_minimum_hex_secret_key_generated_with_openssl"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_DB=encheres_db
DATABASE_URL=""

# Redis Cache & Real-time (utiliser rediss:// en production avec TLS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_redis_password

# Google Gemini API
GEMINI_API_KEY="replace_with_your_gemini_api_key"
GEMINI_MODEL="gemini-1.5-flash"

# Apple App Store Server API + vérification des JWS (racines Apple encodées en base64,
# séparées par des virgules). Un bearer token signé peut remplacer les clés privées.
APPLE_IAP_PRIVATE_KEY=""
APPLE_IAP_KEY_ID=""
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_BEARER_TOKEN=""
APPLE_IAP_VERIFY_URL="https://api.storekit.itunes.apple.com"
APPLE_BUNDLE_ID="com.example.encheres"
APPLE_APP_ID=""
APPLE_ENVIRONMENT="Production"
APPLE_ROOT_CERTIFICATES_B64=""

# Google Play Developer API et AdMob SSV
GOOGLE_PLAY_PACKAGE_NAME="com.example.encheres"
GOOGLE_PLAY_ACCESS_TOKEN=""
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
ADMOB_REWARD_ITEM="token"
ADMOB_REWARD_AMOUNT=1
ADMOB_ALLOWED_AD_UNIT=""

# Game Economy & Draft Rules
INITIAL_FREE_TOKENS=3
AI_DECK_CREATION_TOKEN_COST=1
DEFAULT_STARTING_BUDGET=1000
DEFAULT_BID_TIMER_SECONDS=15
MAX_ROUNDS_PER_GAME=10
